{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inspection-report-audit verdict",
  "type": "object",
  "required": ["audited_file_sha256", "machine_floor", "score", "verdict"],
  "additionalProperties": false,
  "properties": {
    "audited_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "machine_floor": {
      "type": "object",
      "required": ["exit_code", "errors", "warnings"],
      "properties": {
        "exit_code": { "type": "integer" },
        "errors": { "type": "integer" },
        "warnings": { "type": "integer" }
      }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 10 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "points", "awarded"],
        "properties": {
          "id": { "type": "string", "pattern": "^IRA-[0-9]{3}$" },
          "points": { "type": "integer" },
          "awarded": { "type": "integer" },
          "quoted_failure": { "type": "string" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "route_back", "needs_human"] }
  }
}
